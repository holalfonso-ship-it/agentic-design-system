{
  "name": "agentic-design-system",
  "version": "0.4.1",
  "description": "Aida — sistema de diseño agéntico: tokens + componentes reales de Figma, con metadata, índice y protocolo para agentes IA.",
  "license": "MIT",
  "author": "Alfonso Zamorano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holalfonso-ship-it/agentic-design-system.git"
  },
  "homepage": "https://github.com/holalfonso-ship-it/agentic-design-system#readme",
  "bugs": {
    "url": "https://github.com/holalfonso-ship-it/agentic-design-system/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "typescript",
    "tokens",
    "figma",
    "ai-agents",
    "agentic",
    "storybook"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    },
    "./index.toon": "./index.toon",
    "./CLAUDE.md": "./CLAUDE.md",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.toon",
    "CLAUDE.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate-index": "node scripts/generate-index.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run generate-index && npm test && npm run build:lib",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
